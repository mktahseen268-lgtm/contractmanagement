# Copy to .env and adjust.

# --- Database (PostgreSQL is the target stack) ---
DATABASE_URL=postgresql+psycopg2://cm:cm@localhost:5432/cm
# Zero-setup quick look without Postgres (RLS migration is skipped on SQLite):
# DATABASE_URL=sqlite:///./cm.db

# --- Auth ---
# CHANGE THIS in any real deployment:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-please-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (frontend origin[s], comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Startup ---
# Run `alembic upgrade head` on startup (handy for dev/single-instance; disable in multi-replica prod)
RUN_MIGRATIONS_ON_STARTUP=true
# Seed a demo workspace if the DB is empty
AUTO_SEED=true

# --- Background jobs (Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=        # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=    # defaults to REDIS_URL
# When true, tasks run inline in the caller (no worker needed). docker-compose runs a real worker and sets this false.
CELERY_TASK_ALWAYS_EAGER=true

# --- Object storage (S3-compatible). Leave S3_BUCKET empty for the local-filesystem fallback
# (uploaded files land in apps/api/storage/). For MinIO: `docker compose up -d minio` then set:
# S3_BUCKET=cm-files
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
MAX_UPLOAD_MB=50

APP_NAME=Contract Management API
ENV=dev

# --- Deployment profile (Phase 0 / MMBL on-prem) ---------------------------------------
# saas         = multi-tenant, open registration (the original product)
# single_tenant = one tenant provisioned at install, registration disabled (MMBL profile)
DEPLOYMENT_MODE=saas
# SINGLE_TENANT_ID=            # leave empty to provision/adopt automatically at startup
# SINGLE_TENANT_NAME=Mobilink Microfinance Bank
# SINGLE_TENANT_SLUG=mmbl
# Row security in the database. Must stay true for saas; may be false in single_tenant,
# where one tenant makes the policy a tautology (Oracle VPD / MSSQL policies cost latency).
ENFORCE_DB_ISOLATION=true

# --- Data residency --------------------------------------------------------------------
# Startup refuses to boot if any configured endpoint (object storage, SMTP, OCR, OTel,
# TSA, OIDC, database, redis) resolves to a PUBLIC address and is not allowlisted below.
# We do not geo-locate at runtime — that would itself be a foreign call.
DATA_RESIDENCY_REGION=PK
DATA_RESIDENCY_ENFORCED=true
# Comma-separated hostnames, IPs or CIDRs that are reviewed, documented exceptions.
DATA_RESIDENCY_ALLOW_HOSTS=

# --- Retention tiering -----------------------------------------------------------------
# "10 years of records, 1 year instantly searchable". The nightly archive sweep moves
# executed contracts older than HOT_SEARCH_YEARS to the cold tier; the purge sweep
# hard-deletes past RETENTION_YEARS. Legal hold blocks both, absolutely.
RETENTION_YEARS=10
HOT_SEARCH_YEARS=1
ARCHIVE_STORAGE_PREFIX=archive
# S3 only — e.g. STANDARD_IA or GLACIER. Empty keeps the same storage class.
ARCHIVE_S3_STORAGE_CLASS=

# --- PKI (Phase 1) ----------------------------------------------------------------------
# Key custody. `soft` encrypts keys at rest with the Fernet chain (dev/CI, NOT FIPS);
# `pkcs11` generates and confines keys inside an HSM. Production must use pkcs11.
KEYSTORE_PROVIDER=soft
# HSM_LIBRARY_PATH=/usr/lib/softhsm/libsofthsm2.so   # SoftHSM2 for dev/CI
# HSM_TOKEN_LABEL=cm-test          # preferred over HSM_SLOT (slot ids renumber on reboot)
# HSM_SLOT=0
# HSM_PIN=                          # from a secret store — never commit this

# CA hierarchy. Root is generated once and taken offline; the issuing CA signs day to day.
PKI_ROOT_CN=Contract Management Root CA
PKI_ISSUING_CN=Contract Management Issuing CA
PKI_ORG=Contract Management
PKI_COUNTRY=PK
PKI_ROOT_KEY_ALGORITHM=ec-p384
PKI_ISSUING_KEY_ALGORITHM=ec-p384
PKI_LEAF_KEY_ALGORITHM=ec-p256
PKI_ROOT_VALIDITY_YEARS=20
PKI_ISSUING_VALIDITY_YEARS=10
PKI_LEAF_VALIDITY_DAYS=730
PKI_VISITOR_VALIDITY_DAYS=7

# PUBLIC base URL for CRL + OCSP. These are baked into every issued certificate's CDP/AIA
# extensions and CANNOT be changed retroactively — set this before issuing in production.
PKI_BASE_URL=
CRL_VALIDITY_HOURS=24
CRL_DELTA_VALIDITY_HOURS=1

# Registration Authority. With dual control on, two DIFFERENT officers must approve before
# a certificate is issued. An officer can never approve their own request either way.
RA_DUAL_CONTROL=false

# Revocation checking when validating third-party certificates:
# off | soft_fail (accept when unreachable, with a warning) | hard_fail (reject).
PKI_REVOCATION_CHECK=soft_fail

# --- Signing provider (Phase 2) ----------------------------------------------------------
# internal = visual evidence only (Signatures page + Certificate of Completion).
# pades    = ONE shared organisational PKCS#12 seal. The RFP forbids shared certificates,
#            so this is NOT the compliant setting — kept for deployments with no internal CA.
# pki      = per-signatory PAdES-LTV: each signatory signs with the certificate the internal
#            CA issued them, key held in the keystore (HSM in production). MMBL profile.
#            Requires requirements-sign.txt and a provisioned PKI.
SIGNING_PROVIDER=internal
# RFC-3161 timestamp authority. Without one, signatures carry no independent proof of WHEN
# they were made — strongly recommended for long-lived agreements. Must be reachable from
# inside the deployment (the residency check will block a public TSA unless allowlisted).
SIGNING_TSA_URL=

# --- SMS (Phase 2 — OTP for the visitor eSigning surface) --------------------------------
# console = log only (dev/CI) · http = generic gateway (Jazz/Telenor aggregators) · null = drop
SMS_BACKEND=console
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
# {to} and {text} are substituted. JSON body if it parses as JSON, else form-encoded.
SMS_HTTP_BODY_TEMPLATE=
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_AUTH_VALUE=
SMS_SENDER_ID=MMBL

# --- Visitor eSigning (Phase 2) ----------------------------------------------------------
# External signatories sign with no account: link / kiosk / mobile / QR, OTP identity binding.
ESIGN_ENABLED=true
ESIGN_OTP_LENGTH=6
ESIGN_OTP_TTL_MINUTES=10
ESIGN_OTP_MAX_ATTEMPTS=5
ESIGN_OTP_MAX_SENDS=3
ESIGN_SESSIONS_PER_HOUR=20
# Require the viewer to reach the end of the document before signing unlocks. This is consent
# evidence and is printed on the Certificate of Completion.
ESIGN_REQUIRE_SCROLL=true
# Proof-of-work difficulty for starting a session (0 disables). Self-hosted and
# dependency-free — a CAPTCHA SaaS would be foreign egress, which the residency rule forbids.
ESIGN_POW_BITS=12
ESIGN_INVITATION_TTL_DAYS=90

# --- Workflow engine + SLA clock (Phase 4) -----------------------------------------------
# An SLA in wall-clock hours is wrong for a bank: a review raised at 16:00 on a Friday is not
# overdue on Saturday. Public holidays are per-tenant rows managed at /workflow/holidays.
BUSINESS_WORKING_DAYS=0,1,2,3,4
BUSINESS_DAY_START_HOUR=9
BUSINESS_DAY_END_HOUR=18
SLA_REMINDER_FRACTION=0.75
SLA_SWEEP_SECONDS=900
# Escalate automatically on breach. false = flag it but do not move authority.
SLA_AUTO_ESCALATE=true

# --- Writing assistant -------------------------------------------------------------------
# Corrects and rewrites text the user is drafting. Off unless a model runs inside your own
# network. There is deliberately no hosted option: assistance runs over draft contract text,
# so a foreign endpoint would contradict the data-residency commitment (and the boot-time
# residency check will refuse to start if TEXT_ASSIST_BASE_URL resolves outside the allowlist).
# TEXT_ASSIST_PROVIDER=local
# TEXT_ASSIST_BASE_URL=http://llm.internal:8000/v1   # any OpenAI-compatible server (vLLM, Ollama)
# TEXT_ASSIST_MODEL=qwen2.5-14b-instruct
# TEXT_ASSIST_API_KEY=                               # only if your server requires one
# TEXT_ASSIST_TIMEOUT_SECONDS=30
# TEXT_ASSIST_MAX_CHARS=8000
